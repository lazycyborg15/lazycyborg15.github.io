    "build": "cd client && npm run build",
    "test": "cd client && npm test"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^7.4.0",
    "nodemailer": "^6.9.4",
    "serverless-http": "^3.2.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.0"
  }
}
